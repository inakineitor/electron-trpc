{
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:ci": "pnpm -r test:ci",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "changeset publish",
    "docs:start": "pnpm --filter www dev",
    "docs:build": "pnpm --filter www build",
    "docs:preview": "pnpm --filter www preview",
    "docs:publish": "pnpm --filter www publish-pages"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  }
}
