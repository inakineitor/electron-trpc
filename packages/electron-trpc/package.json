{
  "name": "electron-trpc",
  "description": "Electron support for tRPC",
  "version": "0.7.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/inakineitor/electron-trpc.git"
  },
  "homepage": "https://electron-trpc.dev",
  "bugs": {
    "url": "https://github.com/inakineitor/electron-trpc/issues"
  },
  "keywords": [
    "electron",
    "trpc",
    "ipc",
    "rpc",
    "typescript"
  ],
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "require": "./dist/renderer.cjs",
      "import": "./dist/renderer.mjs"
    }
  },
  "author": "Jason Nall <jsonnull@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "main.d.ts",
    "renderer.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build -c src/main/vite.config.mts && vite build -c src/renderer/vite.config.mts && pnpm build:types",
    "build:types": "tsc -p tsconfig.types.json && pnpm run copy:types",
    "copy:readme": "cp ../../README.md ./",
    "copy:types": "cp dist/main.d.ts dist/renderer.d.ts ./",
    "test": "vitest -c vitest.config.mts",
    "test:ci": "pnpm typecheck && vitest run -c vitest.config.mts --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm copy:readme && pnpm build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "^5.3.0",
    "electron": "^43.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "^2.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@trpc/client": ">=11.18.0 <12",
    "@trpc/server": ">=11.18.0 <12",
    "electron": ">=29"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
