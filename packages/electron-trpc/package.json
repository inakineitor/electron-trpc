{
  "name": "electron-trpc",
  "description": "Electron support for tRPC",
  "version": "0.7.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsonnull/electron-trpc.git"
  },
  "homepage": "https://electron-trpc.dev",
  "bugs": {
    "url": "https://github.com/jsonnull/electron-trpc/issues"
  },
  "keywords": [
    "electron",
    "trpc",
    "ipc",
    "rpc",
    "typescript"
  ],
  "exports": {
    "./main": {
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.ts"
    },
    "./renderer": {
      "require": "./dist/renderer.cjs",
      "import": "./dist/renderer.mjs",
      "types": "./dist/renderer.d.ts"
    }
  },
  "author": "Jason Nall <jsonnull@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "main.d.ts",
    "renderer.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build -c src/main/vite.config.mts && vite build -c src/renderer/vite.config.mts && pnpm build:types",
    "build:types": "dts-bundle-generator --config ./dts-bundle-generator.config.ts && pnpm run copy:types",
    "copy:readme": "cp ../../README.md ./",
    "copy:types": "cp dist/main.d.ts dist/renderer.d.ts ./",
    "test": "vitest -c vitest.config.mts",
    "test:ci": "vitest run -c vitest.config.mts --coverage",
    "prepublishOnly": "pnpm copy:readme && pnpm build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.32.1",
    "@trpc/client": "10.45.2",
    "@trpc/server": "10.45.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "^5.3.0",
    "dts-bundle-generator": "9.5.1",
    "electron": "^43.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^3.23.6"
  },
  "peerDependencies": {
    "@trpc/client": ">10.0.0",
    "@trpc/server": ">10.0.0",
    "electron": ">19.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}
